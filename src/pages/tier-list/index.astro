---
import Base from '../../layouts/Base.astro';
import BeastCard from '../../components/BeastCard.astro';
import Notes from '../../components/Notes.astro';
import { beasts, tiers } from '../../lib/data';

const buckets = [...tiers.tiers, 'Unrated'].map((t) => ({
  tier: t,
  beasts: beasts.filter((b) => (tiers.placements[b.slug] ?? 'Unrated') === t),
}));
const rated = beasts.length - buckets.at(-1)!.beasts.length;
---

<Base title="Tier list" description="Familiar tier list for Beastmaster — ratings by role, maintained alongside the guide.">
  <h1>Tier list</h1>
  <p class="lead">
    {rated === 0 ? 'No ratings entered yet — every familiar sits in Unrated until the guide places them.' : `${rated} of ${beasts.length} familiars rated.`}
    {tiers.updated && <span class="muted small"> Updated {tiers.updated}.</span>}
  </p>
  {tiers.notes && <p class="muted small">{tiers.notes}</p>}

  <Notes id="tier-list" heading="Rating rationale" hint="What the tiers mean (leveling vs. Crucible vs. general), and why the top picks are where they are." />

  {
    buckets.map((b) => (
      <section>
        <h2>
          {b.tier === 'Unrated' ? 'Unrated' : `Tier ${b.tier}`} <span class="badge">{b.beasts.length}</span>
        </h2>
        {b.beasts.length ? (
          <div class="grid">
            {b.beasts.map((beast) => (
              <BeastCard beast={beast} />
            ))}
          </div>
        ) : (
          <p class="muted small">Nobody here yet.</p>
        )}
      </section>
    ))
  }
</Base>
