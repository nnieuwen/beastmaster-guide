---
import Base from '../../layouts/Base.astro';
import StratTabs from '../../components/StratTabs.astro';
import { crucible } from '../../lib/data';

export function getStaticPaths() {
  return crucible.battles.map((b) => ({ params: { id: String(b.id) }, props: { battle: b } }));
}
const { battle } = Astro.props;
const idx = crucible.battles.findIndex((b) => b.id === battle.id);
const prev = crucible.battles[idx - 1];
const next = crucible.battles[idx + 1];
---

<Base title={`Crucible battle ${battle.id}`} description={`Crucible battle ${battle.id}: ${battle.enemies.map((e) => e.name).join(', ')} — elements, signature actions and strategy.`}>
  <nav class="small muted" aria-label="Breadcrumb"><a href="/crucible/">Crucible</a> › Battle {battle.id}</nav>
  <h1>Battle {battle.id}</h1>

  <h2>Enemy pieces</h2>
  <div class="grid">
    {
      battle.enemies.map((e) => (
        <div class="card">
          <div class="row">
            {e.icon ? <img class="icon" src={e.icon} alt="" width="40" height="40" /> : <span class="icon" />}
            <div>
              <strong style="text-transform:capitalize">{e.name}</strong>
              <div class="row small" style="flex-wrap:wrap;margin-top:0.2rem">
                {e.element && <span class="tag">{e.element}</span>}
              </div>
            </div>
          </div>
          {e.action && (
            <p class="small" style="margin:0.6rem 0 0">
              <span class="muted">Signature:</span> <strong>{e.action.name}</strong>
              {e.action.status && <span class="tag" style="margin-left:0.3rem">{e.action.status}</span>}
            </p>
          )}
        </div>
      ))
    }
  </div>
  <p class="muted small" style="margin-top:0.75rem">
    Each piece's resistances are 11 flags in the game data whose meaning isn't decoded yet. Piece attack patterns beyond the signature action aren't in the data at all — that's what the write-up below is for.
  </p>

  <h2>Strategy</h2>
  <StratTabs prefix={`crucible/${battle.id}`} hint="Board layout, turn order, which familiars to bring and the safe opening — one file per variant, rendered as tabs." />

  <nav style="display:flex;justify-content:space-between;margin-top:2.5rem" aria-label="Neighbouring battles">
    <span>{prev && <a href={`/crucible/${prev.id}/`}>← Battle {prev.id}</a>}</span>
    <span>{next && <a href={`/crucible/${next.id}/`}>Battle {next.id} →</a>}</span>
  </nav>
</Base>
