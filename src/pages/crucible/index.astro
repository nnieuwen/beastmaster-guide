---
import { withBase } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import Notes from '../../components/Notes.astro';
import { crucible, boards, quests, battleById } from '../../lib/data';

const ranks = crucible.scoreRank.filter((r) => r.name);
const bonuses = crucible.scoreBonus.filter((b) => b.name);
const questById = new Map(quests.map((q) => [q.id, q]));
const first = boards[0];
---

<Base title="Crucible of the Unbroken" description="Beastmaster's solo board content: the five boards with their tile maps, battles, squad caps and rank syncs, plus scoring, bonuses and strategy write-ups.">
  <h1>Crucible of the Unbroken</h1>
  <p class="lead">
    Beastmaster's own solo content and the way you level captured beasts: five boards of tiles — enemies, shops, campsites, treasure — ending in a boss, scored against
    a rank ladder with named bonuses. Three <em>Unbroken</em> boards unlock through the job quests; the two <em>Master's</em> boards after that.
  </p>

  <h2>Overview & rules</h2>
  <Notes id="crucible" heading="Crucible overview" hint="How a run flows, what the board looks like, how scoring works, and general team advice." />

  <h2>Boards</h2>
  <div class="grid">
    {
      boards.map((b) => {
        const unlock = b.unlockQuestId ? questById.get(b.unlockQuestId) : null;
        const boss = b.bossBattleId ? battleById.get(b.bossBattleId) : null;
        return (
          <a class="card" href={withBase(`/crucible/${b.slug}/`)} style="color:inherit">
            <strong>{b.name}</strong>
            <div class="row small muted" style="flex-wrap:wrap;margin:0.4rem 0">
              <span class="badge">Lv. {b.sync}</span>
              <span class="badge">≤ {b.squadSize} familiars</span>
              <span class="badge">rank sync {b.rankSync}</span>
            </div>
            <div class="small">
              {unlock && <div>Unlock: {unlock.name} (Lv. {unlock.level})</div>}
              <div>
                {b.battleIds.length} battles over {Math.max(...b.tiles.map((t) => t.move))} moves
                {boss && <> · boss: {boss.enemies.map((e) => e.name).join(', ')}</>}
              </div>
            </div>
          </a>
        );
      })
    }
  </div>

  <h2>Score ranks & mode bonuses</h2>
  <div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.75rem">
    {ranks.map((r) => <span class="badge accent">{r.name}</span>)}
  </div>
  {
    first && (
      <p class="small muted">
        Crucible Mode adds a flat bonus on every board: First Degree +{first.modeBonuses.first.toLocaleString()}, Second Degree +{first.modeBonuses.second.toLocaleString()}, Third Degree +
        {first.modeBonuses.third.toLocaleString()}.
      </p>
    )
  }

  <h2>Score bonuses</h2>
  <p class="muted small">Points per bonus on each board, from the game data. A dash means the bonus isn't available on that board.</p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Bonus</th>
          <th>Condition</th>
          {boards.map((b) => <th class="num" title={b.name}>{b.name.replace('Board of the Unbroken', 'Unbroken').replace("Master's Board", "Master's")}</th>)}
        </tr>
      </thead>
      <tbody>
        {bonuses.map((b) => (
          <tr>
            <td><strong>{b.name}</strong></td>
            <td class="small">{b.description}</td>
            {boards.map((bd) => <td class="num">{bd.bonusPoints[b.id] ? bd.bonusPoints[b.id].toLocaleString() : <span class="muted">—</span>}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>All battles</h2>
  <p class="muted small">Every enemy tile in the game data, grouped by board. The first entry of each board is its boss.</p>
  {
    boards.map((b) => (
      <section>
        <h3>
          <a href={withBase(`/crucible/${b.slug}/`)}>{b.name}</a>
        </h3>
        <div class="grid">
          {b.battleIds.map((id, i) => {
            const battle = battleById.get(id);
            return battle ? (
              <a class="card" href={withBase(`/crucible/battles/${battle.id}/`)} style="color:inherit;padding:0.6rem 0.8rem">
                <div class="row" style="justify-content:space-between">
                  <strong>{i === 0 ? 'Boss' : `Battle ${battle.id}`}</strong>
                  <span class="muted small">{battle.enemies.length} piece{battle.enemies.length === 1 ? '' : 's'}</span>
                </div>
                <div class="row" style="margin-top:0.4rem;flex-wrap:wrap">
                  {battle.enemies.map((e) => (e.icon ? <img class="icon sm" src={e.icon} alt={e.name} title={e.name} width="28" height="28" loading="lazy" /> : <span class="tag">{e.name}</span>))}
                  <span class="small muted">{battle.enemies.map((e) => e.name).join(', ')}</span>
                </div>
              </a>
            ) : null;
          })}
        </div>
      </section>
    ))
  }
</Base>
