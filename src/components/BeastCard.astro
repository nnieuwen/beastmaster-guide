---
import { withBase } from '../lib/url';
import type { Beast } from '../lib/types';
import KinBadge from './KinBadge.astro';

interface Props {
  beast: Beast;
  extra?: string;
}
const { beast, extra } = Astro.props;
---

<a class="card row" href={withBase(`/bestiary/${beast.slug}/`)} style="color:inherit;padding:0.6rem 0.8rem">
  {beast.icon ? <img class="icon" src={beast.icon} alt="" width="40" height="40" loading="lazy" /> : <span class="icon" />}
  <span style="min-width:0">
    <strong style="display:block">{beast.name}</strong>
    <span class="small muted" style="display:flex;gap:0.4rem;align-items:center;flex-wrap:wrap">
      <KinBadge kin={beast.kin} />
      {extra}
    </span>
  </span>
</a>
