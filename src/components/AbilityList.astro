---
import type { Ability } from '../lib/types';

interface Props {
  abilities: Ability[];
  showLevel?: boolean;
  compact?: boolean;
}
const { abilities, showLevel = false, compact = false } = Astro.props;
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
---

<ul class="abilities" style="list-style:none;padding:0;margin:0;display:grid;gap:0.75rem">
  {
    abilities.map((a) => (
      <li class="card" style="display:grid;grid-template-columns:auto 1fr;gap:0.75rem 1rem;align-items:start" id={`a-${a.id}`}>
        {a.icon ? <img class="icon" src={a.icon} alt="" width="40" height="40" loading="lazy" /> : <span class="icon" />}
        <div>
          <div class="row" style="flex-wrap:wrap">
            <strong>{a.name}</strong>
            {showLevel && <span class="badge">Lv. {a.level}</span>}
            <span class="tag">{a.category}</span>
            {a.recast > 0 && a.recast !== 2.5 && <span class="tag">Recast {fmt(a.recast)}s</span>}
            {a.cast > 0 && <span class="tag">Cast {fmt(a.cast)}s</span>}
            {a.maxCharges > 1 && <span class="tag">{a.maxCharges} charges</span>}
            {a.combo && <span class="tag">Combo from {a.combo}</span>}
          </div>
          {!compact && a.description && <pre class="desc" style="margin-top:0.35rem">{a.description}</pre>}
          {!compact && !a.description && <p class="muted small" style="margin:0.35rem 0 0">No tooltip text in the game data.</p>}
        </div>
      </li>
    ))
  }
</ul>
